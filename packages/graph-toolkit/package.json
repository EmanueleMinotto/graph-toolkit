{
  "name": "graph-toolkit",
  "version": "0.2.0",
  "description": "Everything in one import: re-exports all @graph-sdk packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmanueleMinotto/graph-toolkit.git",
    "directory": "packages/graph-toolkit"
  },
  "homepage": "https://emanueleminotto.github.io/graph-toolkit/",
  "bugs": {
    "url": "https://github.com/EmanueleMinotto/graph-toolkit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@graph-sdk/core": "workspace:*",
    "@graph-sdk/math": "workspace:*",
    "@graph-sdk/matrix": "workspace:*",
    "@graph-sdk/operations": "workspace:*",
    "@graph-sdk/traversal": "workspace:*",
    "@graph-sdk/paths": "workspace:*",
    "@graph-sdk/trees": "workspace:*",
    "@graph-sdk/coloring": "workspace:*",
    "@graph-sdk/algorithms": "workspace:*",
    "@graph-sdk/generators": "workspace:*",
    "@graph-sdk/normalize": "workspace:*",
    "@graph-sdk/dynamic": "workspace:*",
    "@graph-sdk/embedding": "workspace:*",
    "@graph-sdk/query": "workspace:*",
    "@graph-sdk/io": "workspace:*",
    "@graph-sdk/layout": "workspace:*"
  }
}
