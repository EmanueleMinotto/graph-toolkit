{
  "name": "@graph-sdk/layout",
  "version": "0.1.0",
  "description": "Deterministic 2D layouts: circular, grid, force-directed",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@graph-sdk/core": "workspace:*",
    "@graph-sdk/matrix": "workspace:*"
  },
  "devDependencies": {
    "@graph-sdk/generators": "workspace:*"
  }
}
