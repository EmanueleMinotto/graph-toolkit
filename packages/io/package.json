{
  "name": "@graph-sdk/io",
  "version": "0.2.0",
  "description": "Import and export graphs: JSON, edge list/CSV, DOT, GraphML, GEXF, Mermaid, adjacency CSV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmanueleMinotto/graph-toolkit.git",
    "directory": "packages/io"
  },
  "homepage": "https://emanueleminotto.github.io/graph-toolkit/",
  "bugs": {
    "url": "https://github.com/EmanueleMinotto/graph-toolkit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@graph-sdk/core": "workspace:*",
    "@graph-sdk/matrix": "workspace:*"
  },
  "devDependencies": {
    "@graph-sdk/generators": "workspace:*"
  }
}
